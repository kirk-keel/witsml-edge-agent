      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 },
      "id": 14,
      "options": {
        "showHeader": true
      },
      "title": "Multi-Rig Fleet Efficiency & Well Control Leaderboard",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "P40AE60E18F02DE32" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(rig_id, 'Rig-412') AS rig_id, MAX(COALESCE(well_id, 'WL-9924')) AS well_id, COUNT(*)::int AS decisions, COUNT(*) FILTER (WHERE is_ilt = true)::int AS ilt_events, ROUND((COUNT(*) FILTER (WHERE is_ilt = true)::numeric / GREATEST(COUNT(*), 1)) * 100, 1) AS ilt_rate_pct, COALESCE(ROUND(SUM(ilt_cost_usd) FILTER (WHERE is_ilt = true), 2), 0) AS ilt_cost_usd, COALESCE(ROUND(AVG(rop_fphr) FILTER (WHERE rop_fphr > 0), 2), 0) AS avg_rop_fphr, COALESCE(ROUND(AVG(mse_psi) FILTER (WHERE mse_psi > 0), 0), 0) AS avg_mse_psi FROM ai_decisions GROUP BY COALESCE(rig_id, 'Rig-412') ORDER BY ilt_rate_pct ASC;",
          "refId": "A"
        }
      ]
    }
